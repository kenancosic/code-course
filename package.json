{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"vite\" \"pnpm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-backend.ps1",
    "setup:local": "powershell -ExecutionPolicy Bypass -Command \"$ErrorActionPreference='Stop'; if (!(Test-Path '.env') -and (Test-Path '.env.example')) { Copy-Item '.env.example' '.env' }; if (!(Test-Path 'server\\.env') -and (Test-Path 'server\\.env.example')) { Copy-Item 'server\\.env.example' 'server\\.env' }; if (!(Test-Path 'server\\venv\\Scripts\\python.exe')) { py -3.11 -m venv server\\venv }; & 'server\\venv\\Scripts\\python.exe' -m pip install -r server\\requirements.txt; Push-Location server; try { & '.\\venv\\Scripts\\python.exe' -m alembic upgrade head } finally { Pop-Location }; & 'server\\venv\\Scripts\\python.exe' -m server.seed.seed_roadmaps\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
