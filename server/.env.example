DATABASE_URL=sqlite:///./server/mythiccode.db
AI_BACKEND=codex_cli
CODEX_EXECUTABLE=codex
CODEX_WORKDIR=.
CODEX_TIMEOUT_SECONDS=120
CODEX_QUEUE_MAXSIZE=8
CODEX_MAX_RETRIES=2
# Optional dormant fallback if you ever switch AI_BACKEND away from codex_cli
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=gpt-5.4
LLM_FAST_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=medium
GRIMOIRE_UPLOAD_DIR=./server/uploads/grimoires
DEBUG=true
